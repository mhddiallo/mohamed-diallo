# À copier en .env sur le VPS, puis à compléter.

# URL publique du site
NEXT_PUBLIC_SERVER_URL=https://mohamed-diallo.com

# Clé secrète Payload — générez-la avec : openssl rand -hex 32
PAYLOAD_SECRET=

# Base de données (le mot de passe : openssl rand -hex 24)
POSTGRES_USER=site
POSTGRES_DB=site
POSTGRES_PASSWORD=
